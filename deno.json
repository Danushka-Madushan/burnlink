{
  "name": "@danushka/burnlink",
  "version": "1.0.0",
  "tasks": {
    "start": "deno run --allow-net --allow-env --unstable-kv main.ts",
    "dev": "deno run --watch --allow-net --allow-env --unstable-kv main.ts",
    "check": "deno check main.ts main_test.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --allow-net --allow-env --unstable-kv"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "unstable": [
    "kv"
  ],
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
